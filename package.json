{
  "name": "package-control-monorepo",
  "version": "0.0.1",
  "description": "Package Control - Full-stack application",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "pnpm start:backend & pnpm start:frontend",
    "dev:windows": "concurrently \"pnpm start:backend\" \"pnpm start:frontend\"",
    "build": "pnpm -r run build",
    "start": "pnpm -C apps/backend start",
    "start:dev": "pnpm -C apps/backend start:dev",
    "start:backend": "pnpm -C apps/backend start:dev",
    "start:frontend": "pnpm -C apps/frontend dev",
    "start:frontend:fast": "pnpm -C apps/frontend dev:fast",
    "format": "pnpm -r run format",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test:cov": "pnpm -r run test:cov"
  }
}
